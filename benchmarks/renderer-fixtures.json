{
  "version": 1,
  "startConditions": {
    "build": "npm run build",
    "mode": "production renderer",
    "viewport": "1440x900",
    "throttle": "none",
    "warmupRuns": 2,
    "sampleRuns": 9
  },
  "scenarios": [
    { "id": "markdown-code-stream-150kb", "kind": "markdown", "bytes": 153600, "language": "typescript", "sanity": { "minDomNodes": 20, "maxDomNodes": 5000, "minCommits": 1, "minFrames": 3 } },
    { "id": "markdown-fenced-stream-150kb", "kind": "markdown", "bytes": 153600, "streamEnd": true, "sanity": { "minDomNodes": 20, "maxDomNodes": 5000, "minCommits": 1, "minFrames": 3 } },
    { "id": "markdown-plain-stream-150kb", "kind": "markdown", "bytes": 153600, "sanity": { "minDomNodes": 20, "maxDomNodes": 5000, "minCommits": 1, "minFrames": 3 } },
    { "id": "tool-output-1mb", "kind": "tool", "bytes": 1048576, "sanity": { "minDomNodes": 20, "maxDomNodes": 5000, "minCommits": 1, "minFrames": 3 } },
    { "id": "transcript-1000-turns", "kind": "transcript", "turns": 1000, "sanity": { "minDomNodes": 50, "maxDomNodes": 5000, "minCommits": 1, "minFrames": 3 } },
    { "id": "transcript-legacy-comparison-1000-turns", "kind": "transcript", "turns": 1000, "anchorTurn": 8, "activities": 128, "component": "VirtualTranscript", "sanity": { "minDomNodes": 50, "maxDomNodes": 5000, "minCommits": 1, "minFrames": 3 } },
    { "id": "transcript-viewport-anchored-1000-turns", "kind": "transcript", "turns": 1000, "anchorTurn": 8, "activities": 128, "sanity": { "minDomNodes": 50, "maxDomNodes": 5000, "minCommits": 1, "minFrames": 3 } },
    { "id": "transcript-viewport-streaming-1000-turns", "kind": "transcript", "turns": 1000, "anchorTurn": 8, "activities": 128, "streamingDeltas": 36, "sanity": { "minDomNodes": 50, "maxDomNodes": 5000, "minCommits": 1, "minFrames": 3 } },
    { "id": "diff-2mb", "kind": "diff", "bytes": 2097152, "sanity": { "minDomNodes": 20, "maxDomNodes": 5000, "minCommits": 1, "minFrames": 3 } },
    { "id": "thread-shells-10000", "kind": "list", "items": 10000, "sanity": { "minDomNodes": 20, "maxDomNodes": 5000, "minCommits": 1, "minFrames": 3 } },
    { "id": "workspace-files-10000", "kind": "list", "items": 10000, "sanity": { "minDomNodes": 20, "maxDomNodes": 5000, "minCommits": 1, "minFrames": 3 } },
    { "id": "picker-catalog-10000", "kind": "list", "items": 10000, "sanity": { "minDomNodes": 20, "maxDomNodes": 5000, "minCommits": 1, "minFrames": 3 } },
    { "id": "app-tool-output-stream", "kind": "app", "updates": 120, "linesPerUpdate": 16, "sanity": { "minDomNodes": 50, "maxDomNodes": 5000, "minCommits": 120, "minFrames": 3 } },
    { "id": "long-user-message", "kind": "message", "bytes": 12000, "sanity": { "minDomNodes": 20, "maxDomNodes": 5000, "minCommits": 1, "minFrames": 3 } }
  ]
}
