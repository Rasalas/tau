{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "tau": ["src/renderer/extension-api.ts"],
      "tau/host-extension": ["src/main/host-extension-api.ts"],
      "tau/host": ["src/main/host-extension-worker-protocol.ts"]
    }
  },
  "include": ["examples"],
  // The `tau.d.ts` shims are for an example copied out of this checkout;
  // here `paths` resolves the same modules to the real sources.
  "exclude": ["examples/**/tau.d.ts"]
}
