{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": "..",
    "paths": {
      "tau": [
        "src/renderer/extension-api.ts"
      ],
      "tau/host-extension": [
        "src/main/host-extension-api.ts"
      ],
      "tau/host": [
        "src/main/host-extension-worker-protocol.ts"
      ]
    }
  },
  "include": [
    "../.pi/extensions/tau-session-bridge.ts"
  ]
}
