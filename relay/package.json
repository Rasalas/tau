{
  "name": "tau-push-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tau's push relay: seals a phone's push token into a handle and forwards end-to-end encrypted pushes to FCM and APNs",
  "license": "MIT",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "npx --yes firebase-tools@15.32.0 deploy --only functions --project tau-push-e3c95 --non-interactive"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
