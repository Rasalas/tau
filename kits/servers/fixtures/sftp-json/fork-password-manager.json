{
    "name": "Agency",
    "host": "agency.example.com",
    "protocol": "sftp",
    "username": "agency",
    "password": null,
    "passwordManager": "1password:op://Private/Agency/password",
    "privateKeyPath": "/Users/me/.ssh/agency",
    "passphraseManager": "keychain",
    "passphraseCommand": "pass show agency/key",
    "agent": "$SSH_AUTH_SOCK",
    "sshConfigPath": "/Users/me/.ssh/config",
    "knownHostsPath": "/Users/me/.ssh/known_hosts",
    "hostVerification": false,
    "interactiveAuth": true,
    "hop": { "host": "bastion.example.com", "port": 22, "username": "jump" },
    "remotePath": "/srv/agency",
    "connectTimeout": 20000
}
