{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {},
  "ignorePatterns": ["dist/", "dist-electron/", "node_modules/"],
  "overrides": [
    {
      "files": ["kits/**", "scripts/**", "src/main/**", ".pi/**"],
      "rules": {
        "eslint/no-await-in-loop": "off",
        "oxc/no-map-spread": "off"
      }
    }
  ]
}
