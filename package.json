{
  "name": "tau-pi-desktop-prototype",
  "productName": "Tau",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "THROWAWAY prototype: a Neovim-like desktop host for Pi",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"node scripts/build-preload.mjs --watch\" \"wait-on tcp:5173 file:dist-electron/main/index.js file:dist-electron/preload/bundle.cjs && TAU_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build": "node scripts/build.mjs",
    "build:report": "node scripts/build-report.mjs",
    "build:budget": "npm run build && node scripts/build-report.mjs --check",
    "start": "npm run build && electron .",
    "start:existing": "electron .",
    "start:safe": "TAU_NO_EXTENSIONS=1 npm start",
    "start:report": "node scripts/start-report.mjs",
    "smoke:remote-host": "node scripts/remote-host-smoke.mjs",
    "start:budget": "npm run build:budget && node scripts/start-report.mjs --check",
    "typecheck": "npm run typecheck:extension && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "typecheck:extension": "tsc -p tsconfig.extension.json --noEmit",
    "typecheck:extensions": "tsc -p tsconfig.pi-extensions.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:renderer": "node scripts/renderer-benchmark.mjs",
    "benchmark:renderer:check": "npm run benchmark:renderer -- --check",
    "performance:ci": "npm run typecheck && npm test && npm run build:budget && npm run benchmark:git:check && npm run benchmark:host:check && npm run benchmark:host:full:check && npm run benchmark:renderer -- --no-build --check && npm run start:report -- --check",
    "benchmark:host": "npm run build && node scripts/host-benchmark.mjs",
    "benchmark:host:check": "node scripts/host-benchmark.mjs --check",
    "benchmark:host:full:check": "node scripts/host-benchmark.mjs --full --check --output reports/host-full-report.json",
    "benchmark:git": "npm run build && node scripts/git-benchmark.mjs",
    "benchmark:git:check": "node scripts/git-benchmark.mjs --check"
  },
  "dependencies": {
    "@amaster.ai/pi-computer-use": "^0.1.12",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@tanstack/react-virtual": "^3.13.12",
    "esbuild": "^0.25.12",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.37.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.0.0",
    "electron": "^36.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.0"
  }
}
