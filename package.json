{
  "name": "tau-pi-desktop-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "THROWAWAY prototype: a Neovim-like desktop host for Pi",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 file:dist-electron/main/index.js file:dist-electron/preload/index.cjs && TAU_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "start": "npm run build && electron .",
    "start:safe": "TAU_NO_EXTENSIONS=1 npm start",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.37.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.0.0",
    "electron": "^36.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
