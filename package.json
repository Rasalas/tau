{
  "name": "tau-pi-desktop-prototype",
  "productName": "Tau",
  "desktopName": "de.tbuck.tau.desktop",
  "version": "0.7.28",
  "private": true,
  "type": "module",
  "description": "A desktop workbench for coding agents, built on Pi",
  "author": "Torben Buck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rasalas/tau.git"
  },
  "license": "MIT",
  "main": "dist-electron/main/launcher.js",
  "bin": {
    "tau": "bin/tau.mjs"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dev": "concurrently -k \"vite\" \"tsc -p tooling/tsconfig.electron.json --watch\" \"node scripts/build-preload.mjs --watch\" \"node scripts/build-host-worker.mjs --watch\" \"wait-on file:dist-electron/main/extension-packages.js && node scripts/build-kits.mjs --watch\" \"wait-on tcp:5173 file:dist-electron/main/launcher.js file:dist-electron/preload/bundle.cjs && env -u ELECTRON_RUN_AS_NODE TAU_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build": "node scripts/build.mjs",
    "build:report": "node scripts/build-report.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:browser-connect": "node scripts/build-browser-connect.mjs",
    "build:budget": "npm run build -- --reference && node scripts/build-report.mjs --check && npm run build:web -- --check",
    "start": "npm run build && electron .",
    "start:existing": "electron .",
    "start:safe": "TAU_NO_EXTENSIONS=1 npm start",
    "dist": "npm run build && electron-builder -c tooling/electron-builder.yml --publish never",
    "dist:mac": "npm run build && electron-builder -c tooling/electron-builder.yml --mac --publish never",
    "dist:linux": "npm run build && electron-builder -c tooling/electron-builder.yml --linux --publish never",
    "dist:win": "npm run build && electron-builder -c tooling/electron-builder.yml --win --publish never",
    "start:report": "node scripts/start-report.mjs",
    "smoke:remote-host": "node scripts/remote-host-smoke.mjs",
    "smoke:window-host": "node scripts/window-host-smoke.mjs",
    "smoke:remote-work": "node scripts/remote-work-smoke.mjs",
    "smoke:display": "node scripts/display-smoke.mjs",
    "smoke:extension-install": "node scripts/extension-install-smoke.mjs",
    "smoke:attached": "node scripts/attached-smoke.mjs",
    "smoke:cli-app": "node scripts/cli-app-smoke.mjs",
    "smoke:ssh-pairing": "node scripts/ssh-pairing-smoke.mjs",
    "smoke:host-update": "node scripts/host-update-smoke.mjs",
    "install:mac": "node scripts/install-mac.mjs",
    "packaging:update": "node scripts/packaging/update-packages.mjs",
    "start:budget": "npm run build:budget && node scripts/start-report.mjs --check",
    "dev:instance": "node scripts/dev-instance.mjs",
    "cdp": "node scripts/tau-cdp.mjs",
    "cdp:mobile": "node scripts/tau-mobile-cdp.mjs",
    "lint": "oxlint .",
    "typecheck": "npm run typecheck:extension && npm run typecheck:extensions && npm run typecheck:kits && npm run typecheck:examples && npm run typecheck:relay && tsc -p tsconfig.json --noEmit && tsc -p tooling/tsconfig.electron.json --noEmit",
    "typecheck:extension": "tsc -p tooling/tsconfig.extension.json --noEmit",
    "typecheck:extensions": "tsc -p tooling/tsconfig.pi-extensions.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:renderer": "node scripts/renderer-benchmark.mjs",
    "benchmark:renderer:check": "npm run benchmark:renderer -- --check",
    "performance:ci": "npm run lint && npm run typecheck && npm test && npm run build:budget && npm run benchmark:git:check && npm run benchmark:host:check && npm run benchmark:host:full:check && npm run benchmark:renderer -- --check && npm run start:report -- --check",
    "benchmark:host": "npm run build && node scripts/host-benchmark.mjs",
    "benchmark:host:check": "node scripts/host-benchmark.mjs --check",
    "benchmark:host:full:check": "node scripts/host-benchmark.mjs --full --check --output reports/host-full-report.json",
    "benchmark:git": "npm run build && node scripts/git-benchmark.mjs",
    "benchmark:git:check": "node scripts/git-benchmark.mjs --check",
    "benchmark:compare": "node scripts/compare/run.mjs",
    "compare:screens": "node scripts/compare/screens/run.mjs",
    "screenshots": "node scripts/screenshots/run.mjs",
    "screenshots:site": "node scripts/screenshots/run.mjs --out site/assets --format webp --theme both",
    "site:docs": "node scripts/site/build-docs.mjs",
    "site:catalog": "node scripts/site/build-model-catalog.mjs",
    "typecheck:kits": "tsc -p tooling/tsconfig.kits.json --noEmit",
    "typecheck:examples": "tsc -p tooling/tsconfig.examples.json --noEmit",
    "typecheck:relay": "tsc -p tooling/tsconfig.relay.json --noEmit",
    "build:kits": "node scripts/build-kits.mjs",
    "relay:deploy": "npm --prefix relay ci --ignore-scripts && npm --prefix relay run typecheck && npm --prefix relay run deploy"
  },
  "dependencies": {
    "@amaster.ai/pi-computer-use": "^0.1.12",
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "@anthropic-ai/sandbox-runtime": "0.0.77",
    "@crowecawcaw/xa11y": "0.15.0",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron-updater": "6.6.2",
    "esbuild": "^0.25.12",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "highlight.js": "^11.12.0",
    "html-url-attributes": "^3.0.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.37.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-newline-to-break": "^2.0.0",
    "mdast-util-to-hast": "^13.2.1",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-sanitize-uri": "^2.0.1",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-parse": "^11.0.0",
    "tar": "7.5.22",
    "typebox": "^1.3.27",
    "typescript": "^5.9.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^6.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.3",
    "@testing-library/react": "^16.3.0",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "basic-ftp": "6.2.1",
    "concurrently": "^9.0.0",
    "electron": "^44.4.4",
    "electron-builder": "26.16.1",
    "fake-indexeddb": "^6.2.4",
    "ftp-srv": "^4.6.3",
    "jsdom": "^26.1.0",
    "oxlint": "^1.81.0",
    "ssh2": "^1.17.0",
    "terser": "^5.51.2",
    "uqr": "^0.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.0"
  }
}
