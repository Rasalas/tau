<?xml version="1.0" encoding="utf-8"?>
<!-- TLS everywhere; plain sockets only to this device's own loopback and, from the
     emulator, to the development machine (10.0.2.2). A host never listens in
     plaintext beyond loopback, and the app pins every TLS host itself. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
